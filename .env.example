# 환경 변수 이름 목록 (값 없음). 실제 값은 Vercel 환경 변수에 넣고, 로컬은 `npx vercel env pull .env.local` 로 받는다
# .env.local 은 커밋하지 않는다

# ── Neon (Vercel Marketplace 연동이 자동으로 넣음) ──
# 앱 쿼리용 풀링 연결 (호스트에 -pooler)
DATABASE_URL=
# 마이그레이션(drizzle-kit)용 직접 연결
DATABASE_URL_UNPOOLED=

# ── 로그인 (Auth.js) ── AUTH_URL 은 넣지 않는다 (Vercel 에서는 요청 주소를 자동으로 씀)
# 아무 긴 임의 문자열: npx auth secret
AUTH_SECRET=
# 카카오디벨로퍼스 > 앱 > 플랫폼 키 > REST API 키: 키 값 / 클라이언트 시크릿 "카카오 로그인" 코드
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# Google Cloud > Google 인증 플랫폼 > 클라이언트: 클라이언트 ID / 보안 비밀번호
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── 네이버 검색 API (쇼핑 · 뉴스, 서버에서만) ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── Web Push (VAPID) ── node scripts/vapid-keys.mjs 출력 두 줄. 운영용과 개발용은 따로 만든다
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── 일일 작업 ── Vercel Schedules 가 Authorization: Bearer 로 보냄. 16자 이상 무작위:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# ── 카카오맵 JavaScript 키 (공개, 콘솔에서 도메인 제한) ──
NEXT_PUBLIC_KAKAO_MAP_KEY=
